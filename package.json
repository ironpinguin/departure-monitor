{
  "name": "departure-monitor",
  "private": true,
  "version": "3.1.1",
  "description": "Monitor for departure public transportation",
  "homepage": "https://github.com/ironpinguin/departure-monitor",
  "author": {
    "name": "Michele Catalano",
    "email": "ironpinguin@gmail.com"
  },
  "type": "module",
  "main": "src/main.tsx",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:archives": "pnpm run build && node scripts/create-archives.js",
    "release": "pnpm run build:archives",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:watch": "vitest",
    "test": "vitest run",
    "test:ui": "vitest run --ui",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "i18next": "^26.3.4",
    "i18next-browser-languagedetector": "^8.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.0.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "archiver": "^8.0.0",
    "chalk": "^6.0.1",
    "commander": "^12.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.8",
    "form-data": "^4.0.6",
    "fs-extra": "^11.4.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "tar": "^7.5.23",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "readdir-glob>minimatch": "^11.0.1"
    }
  },
  "packageManager": "pnpm@10.12.4"
}
